# Sluice environment.
#
# Copy to `.env` and fill in the values you have. Every variable below is listed in
# `APP_BLUEPRINT.md` under Environment Variables.
#
# `NEXT_PUBLIC_` variables are inlined into the browser bundle at build time, so
# anything using that prefix is public. The service role key and the founder
# distribution address are deliberately not prefixed and never leave the server.

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------

# A Solana JSON-RPC endpoint for the indexer, which is a server process.
#
# Server-only, and therefore not prefixed `NEXT_PUBLIC_`. Next.js inlines anything
# with that prefix into the browser bundle, so a keyed provider URL placed there
# publishes the key to every visitor. The indexer reads this name first and only
# falls back to the public one below.
#
# A paid provider is recommended, but a free tier is enough to run the indexer.
# Verified against Helius Free on 2026-10-08: JSON-RPC returned slot 454681291 and
# a websocket `accountSubscribe` both connected and held for 12 seconds without
# being dropped. The binding limit is 10 RPC requests/second and 1M credits/month,
# which caps read volume rather than the existence of the stream. The indexer
# issues a bounded number of reads per update, so it sits well inside this.
#
# Do not point a deployed indexer at `https://api.mainnet-beta.solana.com`. It
# rate-limits aggressively and refuses websockets from datacenter IPs, which is
# where the indexer actually runs.
RPC_URL=

# The public RPC, for the browser: wallet balances and transaction submission.
#
# Keep this keyless. It is inlined into the client bundle, so any credential in
# this value is a published credential. Solana's public endpoint needs no key and
# serves this purpose.
NEXT_PUBLIC_SOLANA_RPC_URL=

# mainnet-beta, devnet, or testnet.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Yellowstone gRPC, the lowest-latency transport. Optional, and priced accordingly.
#
# Verified against Helius pricing on 2026-10-08: gRPC is not on the Free plan and
# not on Developer ($49). Developer carries devnet gRPC only. Mainnet gRPC starts
# at Business, $499/month. Tatum's gRPC endpoint is free but capped at 5
# requests/minute, which is a demo allowance rather than a production one.
#
# Leaving GRPC_ENDPOINT blank is therefore the correct setting for anything below
# Business-tier volume, and it is not a compromise: the websocket transport below
# carries the same account updates over the same RPC provider. The indexer logs
# which transport is live and the frontend reports it under the metrics, so the
# difference is visible rather than hidden.
GRPC_ENDPOINT=
GRPC_TOKEN=

# The indexer that owns the live reads. Without it every surface degrades to an
# explicit "not configured" state rather than showing a placeholder figure.
NEXT_PUBLIC_INDEXER_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Panta prediction market
# ---------------------------------------------------------------------------
# The external resolver for milestone markets. `APP_BLUEPRINT.md` §7 makes Panta the
# default and an internal market the fallback, so leaving these blank is a supported
# degraded mode rather than a failure: milestones resolve from the named verifier and
# default to no on silence. The indexer reports which resolver is live at
# `/api/resolver`.
#
# Mint a key at https://docs.panta.market/guides/authentication. Keys are `pk_test_…`
# for the test environment and `pk_live_…` for production.
#
# Deliberately NOT `NEXT_PUBLIC_`-prefixed. This key authenticates writes including
# market creation and trade attribution, and that prefix would inline it into the
# browser bundle.
PANTA_API_KEY=

# The wallet that pays market creation fees and signs milestone markets. A base58
# Solana address. Never a private key: Panta never holds keys and never broadcasts,
# it returns an unsigned transaction that this wallet signs.
PANTA_MARKET_WALLET=

# Catalog category for a milestone question. RWA milestones are `other`.
# One of: sports, crypto, politics, entertainment, finance, science, world, other.
PANTA_CATEGORY=other

# ---------------------------------------------------------------------------
# Programs, filled after deploy
# ---------------------------------------------------------------------------
# Copy every ID from the deploy output. `BUILD_GUIDE.md` step 1.9 requires each one
# to be verified on Solscan before submission; an unverified programme makes the
# build look unfinished.

NEXT_PUBLIC_SETTLEMENT_PROGRAM_ID=
NEXT_PUBLIC_REDEMPTION_PROGRAM_ID=
NEXT_PUBLIC_WATERFALL_PROGRAM_ID=
NEXT_PUBLIC_AUTOPILOT_PROGRAM_ID=
NEXT_PUBLIC_COMPLIANCE_PROGRAM_ID=
NEXT_PUBLIC_BOND_PROGRAM_ID=
NEXT_PUBLIC_VERIFIER_PROGRAM_ID=
NEXT_PUBLIC_CURVE_PROGRAM_ID=

# The program-owned treasury PDA. This is the fee claimer for every Meteora
# routed fee, so it must never be an externally owned wallet.
NEXT_PUBLIC_TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# From https://dashboard.privy.io, create a project and copy the app ID. Without it
# the issuer path is unavailable and the wallet menu says so; the self-custody path
# still works.
NEXT_PUBLIC_PRIVY_APP_ID=

# ---------------------------------------------------------------------------
# Revenue
# ---------------------------------------------------------------------------
# Read by the monthly sweep. Never hardcoded in a programme or a component.
FOUNDER_DISTRIBUTION_ADDRESS=

# Signatures required for a withdrawal above the threshold.
TREASURY_MULTISIG_THRESHOLD=3

# Delay in seconds before an above-threshold withdrawal can execute.
TREASURY_TIMELOCK_SECONDS=172800

# Amount above which multisig and timelock apply.
NEXT_PUBLIC_TREASURY_WITHDRAWAL_THRESHOLD=

# ---------------------------------------------------------------------------
# Data API
# ---------------------------------------------------------------------------
# Data API subscriptions only, and that is a Phase 2 feature. Never used for a core
# on-chain transaction.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_API_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Fees
# ---------------------------------------------------------------------------
# Fixed, published, unchanging rates. Not tiered by volume, not stepped by growth,
# not discounted for whales. Revenue grows because volume grows.
# No fee is ever taken from the LP fee.
NEXT_PUBLIC_FEE_CURVE_BPS=30
NEXT_PUBLIC_FEE_MILESTONEMKT_BPS=50
NEXT_PUBLIC_FEE_SECONDARY_BPS=30
NEXT_PUBLIC_FEE_REDEMPTION_BPS=25
NEXT_PUBLIC_FEE_WATERFALL_BPS=50
NEXT_PUBLIC_FEE_BRIDGE_BPS=15
NEXT_PUBLIC_ISSUANCE_FEE_FLAT_USD=200
NEXT_PUBLIC_ISSUANCE_FEE_BPS=25
NEXT_PUBLIC_PRESET_FEE_FLAT_USD=49
NEXT_PUBLIC_PRESET_FEE_BPS=25
NEXT_PUBLIC_ATTESTATION_MARGIN_BPS=150

# Meteora partner configuration. Both must be the treasury PDA, not an externally
# owned wallet: the partner address is the fee claimer, so whatever sits here
# receives every Meteora routed fee.
NEXT_PUBLIC_DBC_PARTNER_ADDRESS=
NEXT_PUBLIC_DAMMV2_PARTNER_ADDRESS=

# ---------------------------------------------------------------------------
# Draft storage
# ---------------------------------------------------------------------------
# The issuance wizard autosaves to the server rather than to `localStorage`, so a
# draft survives a cleared browser and follows the user to another device.
#
# Production: set both Supabase values and apply
# `supabase/migrations/0001_drafts.sql`.
# Local development: set SLUICE_DRAFT_DIR to a writable directory instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SLUICE_DRAFT_DIR=.sluice-drafts

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# The only switch controlling the seeded fixture. Flipping it must not require a
# redeploy of the programmes, only of the indexer.
NEXT_PUBLIC_DEMO_MODE=true
